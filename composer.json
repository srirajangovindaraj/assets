{
    "name": "bfree/asset-management",
    "description": "laravel asset package",
    "type": "library",
    "license": "MIT",
    "version": "1.8.0",
    "autoload": {
        "psr-4": {
            "Bfree\\AssetManagement\\": "src/"
        }
    },
    "extra":{
        "laravel":{
             "providers": [
                "Bfree\\AssetManagement\\Providers\\AssetManagementServiceProvider"
            ],
        "aliases": {
            "AssetManagement": "Bfree\\AssetManagement\\Facades\\AssetManagement"
        }
        }
    },
     "include": [
        "resources",
        "database"
    ],
    "authors": [
        {
            "name": "sri"
        }
    ],
    "minimum-stability": "dev",
     "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "livewire/livewire": "^3.0"        
    }
}
